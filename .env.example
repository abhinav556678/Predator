# PREDATOR Environment Configuration Template
# Copy this to .env and adjust IPs to match your physical lab setup

# System 1 (Defender) IP
DEFENDER_IP=127.0.0.1

# Member 3 Backend Hub
M3_IP=127.0.0.1
M3_PORT=8000
M3_BACKEND_URL=http://127.0.0.1:8000/events

# Member 4 Deception Server
DECEPTION_HOST=0.0.0.0
DECEPTION_PORT=8080
DECEPTION_SECONDARY_PORT=9000
ENABLE_WEBHOOK=true

# Member 1 Frontend
VITE_API_URL=http://127.0.0.1:8000
